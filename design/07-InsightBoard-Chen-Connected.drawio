tStyle=0;shadow=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="70" y="4025" width="6350" height="50" as="geometry"/></mxCell><mxCell id="07-insightboard-connected-chen-erd-4684" value="(min,max) at an entity counts its participation with the opposite entity. A double connector denotes mandatory participation on that side." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=24;fontColor=#253b51;fontStyle=0;shadow=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="70" y="4092" width="6350" height="50" as="geometry"/></mxCell><mxCell id="07-insightboard-connected-chen-erd-4685" value="Dashed recordId branches are alternatives selected by resource (XOR). Historical targets may no longer exist; these are logical references, not SQL foreign keys." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fontColor=#253b51;fontStyle=0;shadow=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="70" y="4160" width="6350" height="65" as="geometry"/></mxCell><mxCell id="07-insightboard-connected-chen-erd-4686" value="Project–Deal is optional 1:1 under the required unique partial index. Singleton settings, throttle buckets and the write lock have no entity-reference links." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fontColor=#253b51;fontStyle=0;shadow=0;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="70" y="4240" width="6350" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>